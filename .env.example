# ==============================================================================
# AWS & SageMaker MLOps Pipeline Environment Configuration
# Copy this file to '.env' and populate with your credentials.
# ==============================================================================

# AWS Identity & Access Management (IAM) Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1

# Target AWS Account & Infrastructure
AWS_ACCOUNT_ID=533267153786
S3_BUCKET_NAME=consumer-electronics-mlops-533267153786
SAGEMAKER_ROLE_ARN=arn:aws:iam::533267153786:role/service-role/AmazonSageMaker-ExecutionRole

# Pipeline Parameters & Quality Gate Thresholds
RMSE_THRESHOLD=12.0
SM_CHANNEL_TRAIN=processed_data
SM_CHANNEL_VALIDATION=processed_data
SM_MODEL_DIR=model_output

# FastAPI Dashboard Server Config
HOST=127.0.0.1
PORT=8080

# Kaggle API Credentials
KAGGLE_API_TOKEN=your_kaggle_api_token_here

